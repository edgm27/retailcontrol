// RetailControl — esquema de datos (Fase 1: fundaciones)
//
// Reglas:
// - Toda tabla con datos de empresa lleva tenant_id y está protegida con RLS
//   (ver migración *_rls). La aplicación se conecta con el rol rc_app, que NO
//   es dueño de las tablas y NO tiene BYPASSRLS.
// - Las referencias entre entidades de una misma empresa usan claves foráneas
//   compuestas (tenant_id, id) para que la base de datos impida mezclar
//   empresas aunque el código tenga un error.
// - Importes, costos, tasas y cantidades: DECIMAL, nunca float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

// ─────────────────────────────── Identidad (global) ───────────────────────────

enum PlatformRole {
  NONE
  SUPPORT
  SUPERADMIN
}

model User {
  id                String       @id @default(uuid()) @db.Uuid
  name              String?
  email             String       @unique
  emailVerified     DateTime?    @map("email_verified")
  image             String?
  platformRole      PlatformRole @default(NONE) @map("platform_role")
  // Hash scrypt de la contraseña (null = solo acceso por Google / enlace mágico).
  passwordHash      String?      @map("password_hash")
  passwordChangedAt DateTime?    @map("password_changed_at")
  disabledAt        DateTime?    @map("disabled_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  mfaTotp       MfaTotp?
  recoveryCodes RecoveryCode[]

  @@map("users")
}

// Cuentas OAuth/OIDC vinculadas (Auth.js).
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// Sesiones en base de datos: revocables al instante (se borra la fila).
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  sessionToken   String    @unique @map("session_token")
  userId         String    @map("user_id") @db.Uuid
  expires        DateTime
  // Segundo factor verificado para ESTA sesión.
  mfaVerifiedAt  DateTime? @map("mfa_verified_at")
  // Empresa activa elegida por el usuario; siempre se revalida contra Membership.
  activeTenantId String?   @map("active_tenant_id") @db.Uuid
  userAgent      String?   @map("user_agent")
  ipAddress      String?   @map("ip_address")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Segundo factor TOTP (RFC 6238). El secreto se guarda cifrado (AES-256-GCM).
model MfaTotp {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  secretEnc      String    @map("secret_enc")
  confirmedAt    DateTime? @map("confirmed_at")
  // Último paso de tiempo aceptado: impide reutilizar el mismo código.
  lastUsedStep   BigInt?   @map("last_used_step")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_totp")
}

// Códigos de recuperación de un solo uso, guardados como HMAC-SHA256.
model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

// Limitador de frecuencia en PostgreSQL (sin Redis en Fase 1).
model RateLimitBucket {
  key         String   @id
  windowStart DateTime @map("window_start")
  count       Int      @default(0)

  @@map("rate_limit_buckets")
}

// ─────────────────────────────── Planes (global) ──────────────────────────────

enum Currency {
  USD
  VES
}

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  description  String?
  // Precio de EJEMPLO, editable por la plataforma. No es una oferta comercial.
  priceMonthly Decimal  @map("price_monthly") @db.Decimal(18, 2)
  currency     Currency @default(USD)
  // null = sin límite fijo (definido por contrato en la suscripción).
  maxBranches  Int?     @map("max_branches")
  maxUsers     Int?     @map("max_users")
  features     Json     @default("[]")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

// ─────────────────────────────── Empresas (tenant) ────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  legalName String?      @map("legal_name")
  rif       String?
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  settings     TenantSettings?
  memberships  Membership[]
  branches     Branch[]
  warehouses   Warehouse[]
  products     Product[]
  subscription Subscription?
  invitations  Invitation[]
  auditEvents  AuditEvent[]

  @@map("tenants")
}

model TenantSettings {
  tenantId                    String   @id @map("tenant_id") @db.Uuid
  locale                      String   @default("es-VE")
  timezone                    String   @default("America/Caracas")
  baseCurrency                Currency @default(USD) @map("base_currency")
  // Si es true, todos los miembros deben usar MFA (no solo propietario/admin).
  mfaRequiredForAll           Boolean  @default(false) @map("mfa_required_for_all")
  allowNegativeStock          Boolean  @default(false) @map("allow_negative_stock")
  // Ajustes de inventario sobre este valor (en moneda base) requieren aprobación.
  adjustmentApprovalThreshold Decimal  @default(100) @map("adjustment_approval_threshold") @db.Decimal(18, 2)
  // Días de anticipación de las alertas de vencimiento.
  expiryAlertDays             Int[]    @default([7, 15, 30, 60, 90]) @map("expiry_alert_days")
  alertEmailEnabled           Boolean  @default(false) @map("alert_email_enabled")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

enum TenantRole {
  OWNER
  ADMIN
  MANAGER
  WAREHOUSE
  BUYER
  AUDITOR
  READONLY
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      TenantRole
  status    MembershipStatus @default(ACTIVE)
  // Sin filas en membership_branches = acceso a todas las sucursales.
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  branches MembershipBranch[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
  @@map("memberships")
}

model MembershipBranch {
  tenantId     String @map("tenant_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  branchId     String @map("branch_id") @db.Uuid

  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  branch     Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@index([tenantId])
  @@map("membership_branches")
}

model Invitation {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  email       String
  role        TenantRole
  tokenHash   String     @unique @map("token_hash")
  invitedById String     @map("invited_by_id") @db.Uuid
  expiresAt   DateTime   @map("expires_at")
  acceptedAt  DateTime?  @map("accepted_at")
  revokedAt   DateTime?  @map("revoked_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@map("invitations")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses         Warehouse[]
  membershipBranches MembershipBranch[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("branches")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // FK compuesta: el almacén solo puede colgar de una sucursal de su misma empresa.
  branch         Branch            @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  movements      StockMovement[]
  balances       StockBalance[]
  adjustments    StockAdjustment[]
  counts         StockCount[]
  purchaseOrders PurchaseOrder[]
  receipts       GoodsReceipt[]
  transfersFrom  Transfer[]        @relation("TransferFrom")
  transfersTo    Transfer[]        @relation("TransferTo")

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, branchId])
  @@map("warehouses")
}

// Catálogo mínimo en Fase 1 (se amplía en Fase 2: unidades, códigos de barra,
// variantes, lotes). Sirve para probar aislamiento con el mismo SKU.
enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  sku                 String
  name                String
  status              ProductStatus @default(ACTIVE)
  // Unidad base (código del catálogo de unidades en packages/domain/src/units.ts).
  baseUnit            String        @default("UND") @map("base_unit")
  lotTracking         Boolean       @default(false) @map("lot_tracking")
  requiresExpiry      Boolean       @default(false) @map("requires_expiry")
  minStock            Decimal?      @map("min_stock") @db.Decimal(20, 6)
  // Precio de referencia de venta (informativo; no es facturación).
  referencePrice      Decimal?      @map("reference_price") @db.Decimal(20, 2)
  referenceCurrency   Currency?     @map("reference_currency")
  preferredSupplierId String?       @map("preferred_supplier_id") @db.Uuid
  // Costo promedio ponderado en la moneda base de la empresa (valoración).
  avgCost             Decimal       @default(0) @map("avg_cost") @db.Decimal(20, 6)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units             ProductUnit[]
  barcodes          ProductBarcode[]
  lots              Lot[]
  movements         StockMovement[]
  balances          StockBalance[]
  adjustments       StockAdjustment[]
  countLines        StockCountLine[]
  transferLines     TransferLine[]
  preferredSupplier Supplier?           @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  purchaseLines     PurchaseOrderLine[]
  receiptLines      GoodsReceiptLine[]

  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@map("products")
}

// ─────────────────────────────── Inventario (Fase 2) ─────────────────────────
// Reglas: los movimientos son de solo inserción; los saldos se actualizan en la
// misma transacción con UPDATE condicional (sin negativos salvo política); las
// cantidades se guardan en la UNIDAD BASE del producto.

model ProductUnit {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  // Presentación (CAJA, BULTO, PAQ…): cuántas unidades base contiene.
  code         String
  name         String
  factorToBase Decimal  @map("factor_to_base") @db.Decimal(20, 6)
  createdAt    DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, productId, code])
  @@map("product_units")
}

model ProductBarcode {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  code      String
  // Unidad que representa el código (UND por defecto, o una presentación).
  unitCode  String?  @map("unit_code")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, productId])
  @@map("product_barcodes")
}

enum LotStatus {
  AVAILABLE
  QUARANTINE
  DAMAGED
  RECALLED
  EXPIRED
  DEPLETED
}

model Lot {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  lotNumber      String    @map("lot_number")
  expiresAt      DateTime? @map("expires_at") @db.Date
  manufacturedAt DateTime? @map("manufactured_at") @db.Date
  receivedAt     DateTime  @default(now()) @map("received_at")
  status         LotStatus @default(AVAILABLE)
  supplierName   String?   @map("supplier_name")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  product   Product         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  movements StockMovement[]
  balances  StockBalance[]

  @@unique([tenantId, productId, lotNumber])
  @@unique([tenantId, id])
  @@index([tenantId, expiresAt])
  @@map("lots")
}

enum MovementType {
  RECEIPT
  ISSUE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  WASTE
  TRANSFER_OUT
  TRANSFER_IN
  COUNT_ADJUSTMENT
  REVERSAL
}

model StockMovement {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  // Agrupa los movimientos de una misma operación (p. ej. salida FEFO en varios lotes).
  operationId        String       @map("operation_id") @db.Uuid
  type               MovementType
  warehouseId        String       @map("warehouse_id") @db.Uuid
  productId          String       @map("product_id") @db.Uuid
  lotId              String?      @map("lot_id") @db.Uuid
  // Variación con signo en unidad base (+ entra, − sale).
  quantity           Decimal      @db.Decimal(20, 6)
  enteredQuantity    Decimal      @map("entered_quantity") @db.Decimal(20, 6)
  enteredUnit        String       @map("entered_unit")
  unitCost           Decimal?     @map("unit_cost") @db.Decimal(20, 6)
  currency           Currency?
  reason             String?
  referenceType      String?      @map("reference_type")
  referenceId        String?      @map("reference_id")
  reversesMovementId String?      @unique @map("reverses_movement_id") @db.Uuid
  actorUserId        String       @map("actor_user_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")

  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  lot       Lot?      @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, warehouseId, createdAt])
  @@index([tenantId, operationId])
  @@map("stock_movements")
}

model StockBalance {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  lotId       String?  @map("lot_id") @db.Uuid
  // = coalesce(lot_id, uuid cero): permite unicidad incluyendo "sin lote".
  lotKey      String   @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @map("lot_key") @db.Uuid
  onHand      Decimal  @default(0) @map("on_hand") @db.Decimal(20, 6)
  reserved    Decimal  @default(0) @db.Decimal(20, 6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  lot       Lot?      @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([tenantId, warehouseId, productId, lotKey])
  @@index([tenantId, productId])
  @@map("stock_balances")
}

model IdempotencyKey {
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  operation   String
  requestHash String   @map("request_hash")
  result      Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([tenantId, key])
  @@map("idempotency_keys")
}

enum ApprovalStatus {
  PENDING
  APPLIED
  REJECTED
  CANCELLED
}

enum AdjustmentKind {
  ADJUSTMENT
  WASTE
}

model StockAdjustment {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  warehouseId     String         @map("warehouse_id") @db.Uuid
  productId       String         @map("product_id") @db.Uuid
  lotId           String?        @map("lot_id") @db.Uuid
  kind            AdjustmentKind @default(ADJUSTMENT)
  quantity        Decimal        @db.Decimal(20, 6)
  enteredQuantity Decimal        @map("entered_quantity") @db.Decimal(20, 6)
  enteredUnit     String         @map("entered_unit")
  estimatedValue  Decimal        @map("estimated_value") @db.Decimal(20, 2)
  reason          String
  status          ApprovalStatus @default(PENDING)
  requestedById   String         @map("requested_by_id") @db.Uuid
  decidedById     String?        @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?      @map("decided_at")
  decisionNote    String?        @map("decision_note")
  operationId     String?        @map("operation_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")

  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@map("stock_adjustments")
}

enum CountStatus {
  OPEN
  PENDING_APPROVAL
  APPLIED
  CANCELLED
}

model StockCount {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  warehouseId     String      @map("warehouse_id") @db.Uuid
  status          CountStatus @default(OPEN)
  note            String?
  differenceValue Decimal?    @map("difference_value") @db.Decimal(20, 2)
  createdById     String      @map("created_by_id") @db.Uuid
  submittedById   String?     @map("submitted_by_id") @db.Uuid
  approvedById    String?     @map("approved_by_id") @db.Uuid
  submittedAt     DateTime?   @map("submitted_at")
  appliedAt       DateTime?   @map("applied_at")
  operationId     String?     @map("operation_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")

  warehouse Warehouse        @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  lines     StockCountLine[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("stock_counts")
}

model StockCountLine {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  countId   String   @map("count_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  lotId     String?  @map("lot_id") @db.Uuid
  expected  Decimal  @db.Decimal(20, 6)
  counted   Decimal? @db.Decimal(20, 6)

  count   StockCount @relation(fields: [tenantId, countId], references: [tenantId, id], onDelete: Cascade)
  product Product    @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, countId])
  @@map("stock_count_lines")
}

enum TransferStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

model Transfer {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  fromWarehouseId String         @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String         @map("to_warehouse_id") @db.Uuid
  status          TransferStatus @default(DRAFT)
  note            String?
  createdById     String         @map("created_by_id") @db.Uuid
  sentById        String?        @map("sent_by_id") @db.Uuid
  receivedById    String?        @map("received_by_id") @db.Uuid
  sentAt          DateTime?      @map("sent_at")
  receivedAt      DateTime?      @map("received_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  fromWarehouse Warehouse      @relation("TransferFrom", fields: [tenantId, fromWarehouseId], references: [tenantId, id], onDelete: Restrict)
  toWarehouse   Warehouse      @relation("TransferTo", fields: [tenantId, toWarehouseId], references: [tenantId, id], onDelete: Restrict)
  lines         TransferLine[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("transfers")
}

model TransferLine {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  transferId String  @map("transfer_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  // Lote asignado al enviar (FEFO si no se indicó).
  lotId      String? @map("lot_id") @db.Uuid
  quantity   Decimal @db.Decimal(20, 6)

  transfer Transfer @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Cascade)
  product  Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, transferId])
  @@map("transfer_lines")
}

// ─────────────────────────────── Compras y moneda (Fase 3) ──────────────────

model Supplier {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  legalName        String?  @map("legal_name")
  rif              String?
  contactName      String?  @map("contact_name")
  email            String?
  phone            String?
  address          String?
  paymentTermsDays Int?     @map("payment_terms_days")
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]
  receipts       GoodsReceipt[]
  products       Product[]

  @@unique([tenantId, rif])
  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@map("suppliers")
}

enum ExchangeRateSource {
  BCV_MANUAL
  BCV_AUTO
  INTERNAL
}

// Tasa VES por 1 USD. Solo inserción: una corrección es un registro nuevo.
model ExchangeRate {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  rate            Decimal            @db.Decimal(20, 8)
  effectiveDate   DateTime           @map("effective_date") @db.Date
  source          ExchangeRateSource @default(BCV_MANUAL)
  sourceReference String?            @map("source_reference")
  createdById     String?            @map("created_by_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")

  purchaseOrders PurchaseOrder[]
  receipts       GoodsReceipt[]

  @@unique([tenantId, id])
  @@index([tenantId, effectiveDate(sort: Desc), createdAt(sort: Desc)])
  @@map("exchange_rates")
}

model TaxRate {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  rate      Decimal   @db.Decimal(7, 4)
  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, code])
  @@map("tax_rates")
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  number         Int
  supplierId     String              @map("supplier_id") @db.Uuid
  warehouseId    String              @map("warehouse_id") @db.Uuid
  status         PurchaseOrderStatus @default(DRAFT)
  currency       Currency
  // Tasa congelada al aprobar (si la moneda difiere de la base).
  exchangeRateId String?             @map("exchange_rate_id") @db.Uuid
  exchangeRate   Decimal?            @map("exchange_rate") @db.Decimal(20, 8)
  expectedDate   DateTime?           @map("expected_date") @db.Date
  notes          String?
  subtotal       Decimal             @default(0) @db.Decimal(20, 2)
  taxTotal       Decimal             @default(0) @map("tax_total") @db.Decimal(20, 2)
  total          Decimal             @default(0) @db.Decimal(20, 2)
  createdById    String              @map("created_by_id") @db.Uuid
  approvedById   String?             @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?           @map("approved_at")
  closedAt       DateTime?           @map("closed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  supplier   Supplier            @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  warehouse  Warehouse           @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  rateRecord ExchangeRate?       @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)
  lines      PurchaseOrderLine[]
  receipts   GoodsReceipt[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  purchaseOrderId  String  @map("purchase_order_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  // Cantidad pedida en unidad base y como se ingresó.
  quantity         Decimal @db.Decimal(20, 6)
  enteredQuantity  Decimal @map("entered_quantity") @db.Decimal(20, 6)
  enteredUnit      String  @map("entered_unit")
  // Precio por unidad INGRESADA, en la moneda de la orden.
  unitPrice        Decimal @map("unit_price") @db.Decimal(20, 6)
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(7, 4)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(20, 6)

  purchaseOrder PurchaseOrder      @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Cascade)
  product       Product            @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  receiptLines  GoodsReceiptLine[]

  @@unique([tenantId, id])
  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  number           Int
  purchaseOrderId  String?  @map("purchase_order_id") @db.Uuid
  supplierId       String   @map("supplier_id") @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  currency         Currency
  baseCurrency     Currency @map("base_currency")
  // Tasa CONGELADA del documento: nunca se recalcula.
  exchangeRateId   String?  @map("exchange_rate_id") @db.Uuid
  exchangeRate     Decimal? @map("exchange_rate") @db.Decimal(20, 8)
  supplierInvoice  String?  @map("supplier_invoice")
  additionalCosts  Decimal  @default(0) @map("additional_costs") @db.Decimal(20, 2)
  merchandiseTotal Decimal  @default(0) @map("merchandise_total") @db.Decimal(20, 2)
  totalBase        Decimal  @default(0) @map("total_base") @db.Decimal(20, 2)
  notes            String?
  operationId      String   @map("operation_id") @db.Uuid
  createdById      String   @map("created_by_id") @db.Uuid
  receivedAt       DateTime @default(now()) @map("received_at")

  supplier      Supplier           @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  warehouse     Warehouse          @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  rateRecord    ExchangeRate?      @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)
  lines         GoodsReceiptLine[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, receivedAt(sort: Desc)])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  receiptId           String   @map("receipt_id") @db.Uuid
  purchaseOrderLineId String?  @map("purchase_order_line_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  lotId               String?  @map("lot_id") @db.Uuid
  quantity            Decimal  @db.Decimal(20, 6)
  enteredQuantity     Decimal  @map("entered_quantity") @db.Decimal(20, 6)
  enteredUnit         String   @map("entered_unit")
  // Precio por unidad ingresada en la moneda del documento.
  unitPrice           Decimal  @map("unit_price") @db.Decimal(20, 6)
  // Precio pactado en la orden (para mostrar diferencias).
  orderedUnitPrice    Decimal? @map("ordered_unit_price") @db.Decimal(20, 6)
  // Costo puesto en almacén por unidad BASE, en moneda base (incluye gastos prorrateados).
  landedUnitCost      Decimal  @map("landed_unit_cost") @db.Decimal(20, 6)
  movementId          String   @map("movement_id") @db.Uuid

  receipt           GoodsReceipt       @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  product           Product            @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, receiptId])
  @@map("goods_receipt_lines")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  title     String
  body      String
  link      String?
  // Evita duplicados: el mismo aviso no se crea dos veces para el mismo usuario.
  dedupeKey String    @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  emailedAt DateTime? @map("emailed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, userId, dedupeKey])
  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

// ─────────────────────────────── Suscripción ─────────────────────────────────

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

model Subscription {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @unique @map("tenant_id") @db.Uuid
  planId              String             @map("plan_id") @db.Uuid
  status              SubscriptionStatus @default(TRIALING)
  trialEndsAt         DateTime?          @map("trial_ends_at")
  currentPeriodEnd    DateTime?          @map("current_period_end")
  graceEndsAt         DateTime?          @map("grace_ends_at")
  // Límites por contrato (plan Empresarial). null = usar los del plan.
  maxBranchesOverride Int?               @map("max_branches_override")
  maxUsersOverride    Int?               @map("max_users_override")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

// ─────────────────────────────── Auditoría ───────────────────────────────────

// Bitácora inmutable: rc_app solo puede INSERT/SELECT (ver migración *_rls).
// tenant_id null = evento de seguridad de cuenta o de plataforma.
model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  before        Json?
  after         Json?
  metadata      Json?
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_events")
}
