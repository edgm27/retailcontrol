# ─── RetailControl — variables de entorno (ejemplo) ───────────────────────────
# Copie a .env y reemplace TODOS los valores. Nunca suba .env al repositorio.
# En producción, inyecte estos valores desde un gestor de secretos.

# Runtime: rol rc_app (sin BYPASSRLS, no dueño de tablas). RLS siempre activo.
DATABASE_URL="postgresql://rc_app:CAMBIAR_app_password@localhost:5432/retailcontrol?schema=public&connection_limit=10"
# Migraciones: rol rc_owner (dueño del esquema). No usar en runtime.
MIGRATION_DATABASE_URL="postgresql://rc_owner:CAMBIAR_owner_password@localhost:5432/retailcontrol?schema=public"
# Respaldos: rol rc_backup (solo lectura + BYPASSRLS). Solo lo usa scripts/db/backup-restore-test.sh.
BACKUP_DATABASE_URL="postgresql://rc_backup:CAMBIAR_backup_password@localhost:5432/retailcontrol"
# Frase de cifrado de respaldos: en producción, desde el gestor de secretos.
# BACKUP_PASSPHRASE=""
# Solo para `pnpm db:check-drift` (base de datos desechable).
SHADOW_DATABASE_URL="postgresql://rc_owner:CAMBIAR_owner_password@localhost:5432/retailcontrol_shadow?schema=public"

# Usados por scripts/db/bootstrap.sh para crear los roles.
RC_OWNER_PASSWORD="CAMBIAR_owner_password"
RC_BACKUP_PASSWORD="CAMBIAR_backup_password"
RC_APP_PASSWORD="CAMBIAR_app_password"
RC_DB_NAME="retailcontrol"

# Auth.js — genere con: openssl rand -base64 32
AUTH_SECRET="CAMBIAR"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OpenID Connect (opcional). Sin estas variables el botón no se muestra.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cifrado del secreto TOTP — 32 bytes en base64: openssl rand -base64 32
MFA_ENCRYPTION_KEY="CAMBIAR"
# Pimienta para HMAC de códigos de recuperación (>= 32 caracteres): openssl rand -hex 32
RECOVERY_CODE_PEPPER="CAMBIAR"

# MFA obligatorio para propietario/administrador (true por defecto). "false" solo en pruebas.
MFA_ENFORCE_PRIVILEGED_ROLES="true"

# Administrador inicial (opcional; lo crea scripts/deploy/start-web.sh si no existe).
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
ADMIN_COMPANY_NAME="Empresa de pruebas"

# Correo: "dev-file" escribe los enlaces en DEV_MAILBOX_DIR (solo desarrollo/pruebas).
# "smtp" usa SMTP_URL (p. ej. smtp://usuario:clave@host:587).
EMAIL_TRANSPORT="dev-file"
EMAIL_FROM="RetailControl <no-responder@example.com>"
SMTP_URL=""
DEV_MAILBOX_DIR=".dev-mailbox"

# Observabilidad
LOG_LEVEL="info"
